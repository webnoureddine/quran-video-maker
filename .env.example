# ── Supabase (leave both empty to run locally without accounts or cloud storage) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never put this key in front-end code or commit it.
SUPABASE_SERVICE_KEY=

# ── Server ──
PORT=8000
WORKERS=1                 # renders running at the same time (each uses ~1-2 CPU cores)
DATA_DIR=./data           # local library (dev), caches, finished videos
WORK_DIR=./work           # temporary render folders (cleaned automatically)

# ── Limits ──
MAX_AYAHS=40
MAX_AUDIO_SECONDS=900
MAX_BG_ITEMS=30
MAX_UPLOAD_MB=50
OUTPUT_LIMIT_MB=48        # finished video is re-encoded to stay under this (0 = no limit)
DAILY_JOB_LIMIT=20        # videos per user per 24 h
RETENTION_DAYS=7          # finished videos are deleted after this many days
TARGET_LUFS=-14           # recitation loudness (0 = leave untouched)

# ── Watermark ──
LOGO_PATH=./assets/logo.png   # default logo used when watermark is on but the user uploaded none
FORCE_WATERMARK=false

# ── Advanced ──
VIDEO_HWENC=auto          # auto | cpu  (GPU encoders are detected automatically)
CAPTION_RESHAPE=0         # 1 only if your ffmpeg's libass lacks HarfBuzz (very rare)

# ── Recitation recognition (uploaded audio -> surah & ayahs) ──
WHISPER_MODEL=small       # tiny | base | small | medium (more accurate, slower); downloaded once
SYNC_ASR=1                # word-level caption sync with speech recognition (0 = pause detection only, faster)
